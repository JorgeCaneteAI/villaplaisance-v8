RewriteEngine On
RewriteBase /

# ═══ Listing dossiers désactivé ═══
Options -Indexes

# ═══ Fichiers sensibles : refus d'accès ═══
<FilesMatch "^(\.env.*|\.git.*|composer\.(json|lock)|package(-lock)?\.json|.*\.sql|.*\.bak|.*\.log|README\.md|DEPLOY\.md)$">
    Require all denied
</FilesMatch>

# ═══ Headers de sécurité ═══
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Permissions-Policy "interest-cohort=(), browsing-topics=()"
    Header unset X-Powered-By
    Header unset Server
</IfModule>

# ═══ PWA — MIME types + Service Worker scope ═══
AddType application/manifest+json .webmanifest
<Files "sw.js">
    Header set Service-Worker-Allowed "/"
</Files>

# ═══ Force HTTPS (production) ═══
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ═══ Redirect www → non-www ═══
RewriteCond %{HTTP_HOST} ^www\.villaplaisance\.fr$ [NC]
RewriteRule ^(.*)$ https://villaplaisance.fr/$1 [R=301,L]

# ═══ Old page slugs → new URLs ═══
RewriteRule ^chambre-hotes-bedarrides/?$ /chambres-d-hotes [R=301,L]
RewriteRule ^maison-hotes-bedarrides/?$ /location-villa-provence [R=301,L]
RewriteRule ^recommandations/?$ /sur-place [R=301,L]
RewriteRule ^politique-confidentialite-bedarrides/?$ /politique-confidentialite [R=301,L]
RewriteRule ^politique-de-cookies-ue/?$ /politique-confidentialite [R=301,L]
RewriteRule ^hello-world/?$ / [R=301,L]

# If file or directory exists, serve it directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route everything through index.php
RewriteRule ^(.*)$ index.php [QSA,L]
